#!/bin/sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_message() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

echo ""

{{ if eq .chezmoi.os "linux" }}
    
    {{ if eq .chezmoi.osRelease.id "fedora" }}

        print_message "Fedora Linux Detected!"

        sudo dnf clean all
        sudo dnf install -y wayscriber
        sudo dnf install -y wayscriber-configurator

        sudo dnf install -y \
            git \
            git-crypt \
            delta \
            gnupg \
            stow \
	        nvim \
            kitty \
            zsh \
            zoxide \
            fzf \
            yazi \
            grim \
            slurp \
            satty \
            cliphist \
            poppler \
            resvg \
            fastfetch \
            onefetch \
            htop \
            xz \
            jq \
            eza \
            gcc \
            gcc-c++ \
            clang-tools-extra \
            valgrind \
            rustup \
            java \
            java-devel \
            java-25-openjdk-src \
            dotnet-sdk-10.0 \
            librewolf \
            bibata-cursor-themes
    {{ end }}
{{ end }}
