#!/bin/sh

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

print_message() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

echo ""

{{ if eq .chezmoi.os "linux" -}}
    {{ if eq .chezmoi.osRelease.id "fedora" -}}

        print_message "Fedora Linux Detected!"

        sudo dnf clean all

        sudo dnf install -y {{ range .packages.fedora.dnf }}{{ . }} {{ end }}
    {{ end -}}
{{ end -}}
